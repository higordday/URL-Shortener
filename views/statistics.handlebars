<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">

    <title>URL Shortener | Statistics</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.css" integrity="sha512-x9WwyMYBnlXMNQ6kQ/Lyzu1NqIhLQKL5Oq6xByfXuRj7s9CskyCbLv/1IjqzJmXwFXWr0ov6jBV7Qbc0hh9nHg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    
    <link rel="stylesheet" href="/css/pages/statistics.css">

</head>
<body>

    <main class="app">
        <div class="dashboard">

            <header class="dashboard__header">
                <a class="back" href="/"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Back to Home</a>

                <h1 class="dashboard__title">Link Statistics</h1>
            </header>

            <section class="overview" aria-label="Resumo do link">

                <article class="visits">
                    <span class="visits__icon" aria-hidden="true"><i class="fa-solid fa-eye"></i></span>

                    <p class="visits__label">Visits Counter</p>
                    <p class="visits__value">{{ visits }}</p>
                </article>

                <dl class="details">

                    <div class="details__item">
                        <dt class="details__label"><i class="fa-solid fa-key" aria-hidden="true"></i>Private Token</dt>

                        <dd class="details__value">
                            <code class="details__code" id="token-value" data-secret="{{private_token}}">••••••••••••••••••••••••••••••••</code>

                            <button class="icon-btn" type="button" id="token-toggle" aria-label="Mostrar token" aria-pressed="false"><i class="fa-solid fa-eye" aria-hidden="true"></i></button>

                            <button class="icon-btn" type="button" data-copy="token-value" aria-label="Copiar token"><i class="fa-regular fa-copy" aria-hidden="true"></i></button>
                        </dd>
                    </div>

                    <div class="details__item">
                        <dt class="details__label"><i class="fa-solid fa-hashtag" aria-hidden="true"></i>Unique Code</dt>

                        <dd class="details__value">
                            <code class="details__code" id="code-value">{{id}}</code>

                            <button class="icon-btn" type="button" data-copy="code-value" aria-label="Copiar código"><i class="fa-regular fa-copy" aria-hidden="true"></i></button>
                        </dd>
                    </div>

                    <div class="details__item details__item--wide">
                        <dt class="details__label"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>Redirect URL</dt>

                        <dd class="details__value">
                            <a class="details__link" id="redirect-value" href="{{redirect}}" target="_blank" rel="noopener noreferrer">{{redirect}}</a>

                            <button class="icon-btn" type="button" data-copy="redirect-value" aria-label="Copiar URL"><i class="fa-regular fa-copy" aria-hidden="true"></i></button>
                        </dd>
                    </div>

                </dl>

            </section>

            <section class="logs" aria-labelledby="logs-title">

                <div class="logs__header">
                    <h2 class="logs__title" id="logs-title">Access Logs</h2>

                    <span class="logs__count">{{logs_counter}} Logs</span>
                </div>

                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>

                                <th scope="col">IP</th>
                                <th scope="col">Country</th>
                                <th scope="col">Region</th>
                                <th scope="col">City</th>
                                <th scope="col">Click Date</th>

                            </tr>
                        </thead>

                        <tbody>

                            {{#each logs}}

                                <tr>
                                    <td data-label="IP"><code>{{this.ip}}</code></td>
                                    <td data-label="País">{{this.country}}</td>
                                    <td data-label="Estado">{{this.region}}</td>
                                    <td data-label="Cidade">{{this.city}}</td>
                                    <td data-label="Data do clique"><time datetime="2026-10-24T14:32:08">{{this.click_date}}</time></td>
                                </tr>

                            {{/each}}

                        </tbody>
                    </table>
                </div>

            </section>

            <section class="danger" aria-labelledby="danger-title">
                <div class="danger__text">

                    <h2 class="danger__title" id="danger-title">Exclude Link</h2>
            
                </div>

                <button class="btn btn--danger" type="button" id="delete-open"><i class="fa-solid fa-trash" aria-hidden="true"></i>Exclude Link</button>
            </section>

        </div>
    </main>

    <div class="real_modal">
        <dialog class="modal" id="delete-modal" aria-labelledby="modal-title">

            <form class="modal__box" action="" method="post">
                <input type="hidden" name="action" value="delete">

                <h2 class="modal__title" id="modal-title">Do you want to delete this Link?</h2>

                <div class="modal__actions">

                    <button class="btn btn--ghost" type="button" id="delete-cancel">Cancel</button>
                    <button class="btn btn--danger" type="button" onclick="exclude_link('{{private_token}}')">Exclude Link</button>

                </div>
            </form>

        </dialog>
    </div>

    <script>

        (function ()
        {

            const token = document.getElementById('token-value');
            const toggle = document.getElementById('token-toggle');
            const mask = token.textContent;

            toggle.addEventListener('click', function ()
            {

                const visible = toggle.getAttribute('aria-pressed') === 'true';

                token.textContent = visible ? mask : token.dataset.secret;

                toggle.setAttribute('aria-pressed', !visible);
                toggle.setAttribute('aria-label', visible ? 'Mostrar token' : 'Ocultar token');

                toggle.firstElementChild.className = visible ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';

            });

            document.querySelectorAll('[data-copy]').forEach(function (button)
            {

                button.addEventListener('click', function ()
                {

                    const source = document.getElementById(button.dataset.copy);

                    const text = source.dataset.secret || source.textContent.trim();
                    const icon = button.firstElementChild;

                    navigator.clipboard.writeText(text).then(function ()
                    {

                        icon.className = 'fa-solid fa-check';
                        button.classList.add('is-done');

                        setTimeout(function ()
                        {

                            icon.className = 'fa-regular fa-copy';
                            button.classList.remove('is-done');

                        }, 1500);

                    });

                });

            });

            const real_modal = document.querySelector('.real_modal');
            const modal = document.getElementById('delete-modal');

            document.getElementById('delete-open').addEventListener('click', function () { real_modal.style.display = 'flex'; modal.showModal(); });
            document.getElementById('delete-cancel').addEventListener('click', function () { real_modal.style.display = 'none'; modal.close(); });

            modal.addEventListener('click', function (event)
            {

                if (event.target === modal) real_modal.style.display = 'none'; modal.close();

            });

        })();

        function exclude_link(private_token) 
        {

            fetch
            (
                '/urls/delete', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ private_token: private_token }) }

            ).then( (response) => 
            {

                if (!response.ok) 
                {

                    console.error('URL Deletion Failure - HTTP DELETE Request Failed'); alert('Failed to delete URL'); return;

                }

                return response.json();

            }).then( (data) => 
            {

                if (!data.status) { alert(data.error); return; }

                alert('Successfully deleted URL');

                window.location.href = '/';

            }).catch( (error) => 
            {

                console.error(error.message); alert('Failed to delete URL');

            });

        }

    </script>

</body>
</html>